rules_version = '2';

// Tailor app — Firestore security rules.
//
// Data layout:
//   users/{uid}                     -> shop owner profile
//   shops/{shopId}/orders/{orderId} -> that shop's orders
//
// The app uses the Firebase Auth uid as the shopId, so a shop can only ever
// read or write its own documents.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read/write only their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // A shop's orders are private to that shop's owner.
    match /shops/{shopId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == shopId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
